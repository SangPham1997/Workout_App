# ===== Web App (src/) - copy file này thành .env ở gốc dự án =====
# SANITY_PROJECT_ID: vào https://sanity.io/manage -> project của bạn -> copy ID (chuỗi ~14 ký tự)
VITE_SANITY_PROJECT_ID=your-project-id
VITE_SANITY_DATASET=production

# ===== Sanity Studio (sanity-studio/) - copy thành sanity-studio/.env.local =====
SANITY_STUDIO_PROJECT_ID=your-project-id
SANITY_STUDIO_DATASET=production

# ===== Token để chạy script migrate data (chỉ dùng cục bộ, KHÔNG commit) =====
# Tạo tại: https://sanity.io/manage -> Project -> API -> CAPI tokens (Editor)
SANITY_API_TOKEN=
