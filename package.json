{
  "name": "homecycle-monorepo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "src",
    "sanity-studio"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:web\" \"npm run dev:studio\"",
    "dev:web": "npm run dev --workspace=src",
    "dev:studio": "npm run dev --workspace=sanity-studio",
    "build": "npm run build --workspaces",
    "build:web": "npm run build --workspace=src",
    "build:studio": "npm run build --workspace=sanity-studio",
    "deploy:studio": "npm run deploy --workspace=sanity-studio",
    "typegen": "npm run typegen --workspace=sanity-studio",
    "migrate": "npm run migrate --workspace=sanity-studio",
    "lint": "npm run lint --workspaces"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
